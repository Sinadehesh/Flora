{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/gemjar/",
      "destination": "/apps/gemjar/",
      "permanent": true
    },
    {
      "source": "/:path((?!floralock|shroomlock|cloudlock|app-lockers|testers|mergefarmstead|debubble|gemjar|apps|app-ads\\.txt|robots\\.txt|sitemap\\.xml).*)",
      "has": [
        {
          "type": "host",
          "value": "www.sinadehesh.com"
        }
      ],
      "destination": "https://sinadehesh.com/:path",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/:path((?!shroomlock|floralock|cloudlock|app-lockers|testers|mergefarmstead|debubble|gemjar|apps|app-ads\\.txt|robots\\.txt|sitemap\\.xml).*)",
      "has": [
        {
          "type": "host",
          "value": "shroomlock.sinadehesh.com"
        }
      ],
      "destination": "/shroomlock/:path"
    },
    {
      "source": "/:path((?!shroomlock|floralock|cloudlock|app-lockers|testers|mergefarmstead|debubble|gemjar|apps|app-ads\\.txt|robots\\.txt|sitemap\\.xml).*)",
      "has": [
        {
          "type": "host",
          "value": "cloudlock.sinadehesh.com"
        }
      ],
      "destination": "/cloudlock/:path"
    }
  ]
}
