{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/:path((?!floralock|shroomlock|app-lockers|robots\\.txt|sitemap\\.xml).*)",
      "has": [
        {
          "type": "host",
          "value": "www.sinadehesh.com"
        }
      ],
      "destination": "https://sinadehesh.com/:path",
      "permanent": false
    }
  ]
}
